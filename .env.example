# Unified social feed
# Keep every token server-only. Never rename these to NEXT_PUBLIC_*.
#
# Posts can be filed into Essays, Books, Daily, or Builds with markers such as
# #essay, #book, #daily, and #build. Each connector can also have a fallback:
SOCIAL_YOUTUBE_DEFAULT_PILLAR=daily
SOCIAL_TIKTOK_DEFAULT_PILLAR=daily
SOCIAL_INSTAGRAM_DEFAULT_PILLAR=daily
SOCIAL_FACEBOOK_DEFAULT_PILLAR=daily
SOCIAL_X_DEFAULT_PILLAR=daily
SOCIAL_LINKEDIN_DEFAULT_PILLAR=daily

# YouTube public RSS (no API key required)
YOUTUBE_CHANNEL_ID=

# X API v2
X_BEARER_TOKEN=
X_USER_ID=
X_USERNAME=

# TikTok Display API (requires an approved app and video.list scope)
TIKTOK_ACCESS_TOKEN=
TIKTOK_USERNAME=

# Instagram API with Instagram Login (Business or Creator account)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_USERNAME=

# Meta Graph API shared settings
META_GRAPH_VERSION=v23.0

# Facebook Pages API (personal-profile posts are not supported)
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_NAME=
FACEBOOK_PROFILE_URL=

# LinkedIn Posts API
# Member posts require approved r_member_social access. Organization posts
# require the appropriate organization permissions.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_AUTHOR_NAME=
# Use a currently supported YYYYMM LinkedIn API version.
LINKEDIN_VERSION=

# Amazon Associates
# Public because the tracking tag must be present in outbound Amazon links.
NEXT_PUBLIC_AMAZON_ASSOCIATES_TAG=

# Contact and photography forms (Gmail App Password, server-only)
GMAIL_USER=
GMAIL_APP_PASSWORD=
